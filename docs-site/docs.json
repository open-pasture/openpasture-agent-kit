{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Openpasture",
  "description": "The open-source grazing decision engine between land data and virtual-fence collars.",
  "colors": {
    "primary": "#ff4f7b",
    "light": "#ff8fa8",
    "dark": "#06070a"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "IBM Plex Mono",
      "weight": 600
    },
    "body": {
      "family": "IBM Plex Mono",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "grid"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "banner": {
    "content": "Openpasture Cloud is in public beta. [Get started](https://app.openpasture.dev/sign-up) or [view source on GitHub](https://github.com/open-pasture/openpasture-agent-kit).",
    "dismissible": true
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/open-pasture/openpasture-agent-kit"
      },
      {
        "label": "Website",
        "href": "https://openpasture.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.openpasture.dev/sign-up"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/open-pasture/openpasture-agent-kit",
      "x": "https://x.com/openpasture"
    },
    "links": [
      {
        "header": "Platform",
        "items": [
          { "label": "Agent Kit", "href": "https://openpasture.dev/agent-kit" },
          { "label": "Cloud", "href": "https://openpasture.dev/cloud" },
          { "label": "Integrations", "href": "https://openpasture.dev/integrations" },
          { "label": "Pricing", "href": "https://openpasture.dev/pricing" }
        ]
      },
      {
        "header": "Community",
        "items": [
          { "label": "GitHub", "href": "https://github.com/open-pasture/openpasture-agent-kit" },
          { "label": "Contributing", "href": "/contributing" },
          { "label": "Open Source", "href": "https://openpasture.dev/open-source" },
          { "label": "Mission", "href": "https://openpasture.dev/mission" }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "chatgpt", "claude", "cursor"],
    "display": "header"
  },
  "search": {
    "prompt": "Search Openpasture docs..."
  },
  "redirects": [
    { "source": "/introduction", "destination": "/" },
    { "source": "/installation", "destination": "/quickstart" },
    { "source": "/environment", "destination": "/environment-variables" },
    { "source": "/reference/cli/overview", "destination": "/cli" },
    { "source": "/reference/connectors/mcp", "destination": "/mcp-connector" },
    { "source": "/mcp", "destination": "/mcp-connector" },
    { "source": "/configuration/environment", "destination": "/environment-variables" },
    { "source": "/configuration/storage", "destination": "/architecture" },
    { "source": "/developer-guidance", "destination": "/contributing" }
  ],
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": ["index", "quickstart", "core-concepts"]
      },
      {
        "group": "The Engine",
        "pages": ["decision-engine", "land-reports", "collars"]
      },
      {
        "group": "Use The Kit",
        "pages": ["cli", "mcp-connector", "hermes-adapter", "skills", "knowledge"]
      },
      {
        "group": "Deploy",
        "pages": ["self-hosting", "hosted-cloud", "environment-variables", "troubleshooting"]
      },
      {
        "group": "Develop",
        "pages": ["architecture", "contributing", "changelog"]
      }
    ]
  }
}
